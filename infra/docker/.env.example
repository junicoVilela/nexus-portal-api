# Copie este arquivo para `.env` (mesma pasta) antes de subir o compose.
# `.env` é ignorado pelo git.

# =====================================================================
# Postgres — defaults batem com application-dev.yml do backend.
# =====================================================================
POSTGRES_DB=softon_intranet
POSTGRES_USER=softon_intranet
POSTGRES_PASSWORD=softon!@#
POSTGRES_PORT=5432

# =====================================================================
# Jenkins (profile: ci)
# =====================================================================
JENKINS_PORT=8090
JENKINS_AGENT_PORT=50000
JENKINS_URL=http://localhost:8090/
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin

# GitHub PAT — github.com → Settings → Developer settings → Tokens (classic)
# Escopos: repo + workflow
GITHUB_USER=seuuser
GITHUB_PAT=ghp_cole_aqui_o_token

# Webhook secret do portal (S11 P2).
# Tem que casar com RELEASE_ORCHESTRATOR_WEBHOOKS_JENKINS_SECRET no backend.
# Gere com: openssl rand -hex 32
PORTAL_WEBHOOK_SECRET=cole_aqui_o_mesmo_secret_do_portal

# =====================================================================
# MinIO (profile: bucket)
# =====================================================================
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# =====================================================================
# SFTP (profile: sftp)
# =====================================================================
SFTP_PORT=2222
SFTP_USER=foo
SFTP_PASSWORD=senha
