// =============================================================================
// Jenkinsfile — build-on-tag para produtos Nexus
// =============================================================================
// Copie este arquivo para a raiz do repositório do produto (`Jenkinsfile`)
// e ajuste os valores em PIPELINE_CONFIG abaixo. Documentação completa em
// nexus-portal-api/docs/release-orchestrator/39-entregaveis-cicd-repositorios.md
//
// Pré-requisitos no Jenkins:
//   - Credencial String 'github-pat-nexus'  → Personal Access Token com
//     escopo `repo` (upload de releases). Ver runbook S8.
//   - Tool 'maven-3.9' configurada (ou ajuste em options.tool)
//   - Plugin Pipeline + GitHub Branch Source
//
// Trigger:
//   - Tag Git v*.*.* (job filter) OU disparo pelo portal (buildWithParameters
//     com RELEASE_VERSION, TAG_NAME, GIT_REF, PORTAL_PRODUCT_SIGLA).
// =============================================================================

pipeline {
  agent any

  parameters {
    string(name: 'RELEASE_VERSION', defaultValue: '', description: 'Versão sem prefixo v (ex.: 5.0.0)')
    string(name: 'TAG_NAME', defaultValue: '', description: 'Tag git (ex.: v5.0.0). Vazio = tag que disparou o job.')
    string(name: 'GIT_REF', defaultValue: '', description: 'Ref de checkout. Vazio = refs/tags/TAG_NAME')
    string(name: 'PORTAL_PRODUCT_SIGLA', defaultValue: '', description: 'Sigla do produto no portal')
    string(name: 'ORIGEM', defaultValue: '', description: 'RELEASE_ATUAL | TAG_ESPECIFICA | ULTIMA_GERADA')
  }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  environment {
    // ----- ajuste por produto -----
    PRODUTO_SIGLA    = 'NEXUSLD'           // sigla maiúscula igual ao cadastro do portal
    MODULO_CODIGO    = 'nexus-web'         // ex: nexus-web, nexus-batch
    ARTIFACT_EXT     = 'war'              // war | jar | zip | tar.gz
    BUILD_CMD        = 'mvn -B -ntp clean package -DskipTests'
    BUILD_OUTPUT_DIR = 'target'           // dir onde o artefato é gerado
    // Webhook do portal: URL absoluta + secret. S11 P2 — badge na release.
    PORTAL_WEBHOOK_URL = 'https://portal.nexus.local/api/v1/release-orchestrator/webhooks/jenkins'
    // ------------------------------

    GH_TOKEN     = credentials('github-pat-nexus')
    PORTAL_SECRET = credentials('nexus-portal-webhook-secret')
  }

  tools {
    maven 'maven-3.9'
    jdk   'jdk-21'
  }

  stages {

    stage('Checkout tag') {
      steps {
        script {
          // Portal (buildWithParameters) envia TAG_NAME/GIT_REF; trigger git preenche env.TAG_NAME.
          def tag = (params.TAG_NAME ?: '').toString().trim() ?: env.TAG_NAME
          def gitRef = (params.GIT_REF ?: '').toString().trim()
          if (!tag && !gitRef) {
            error 'Informe TAG_NAME ou GIT_REF (portal), ou dispare o job numa tag v*.*.*.'
          }
          if (!tag && gitRef.startsWith('refs/tags/')) {
            tag = gitRef.replaceFirst(/^refs\/tags\//, '')
          }
          if (!gitRef) {
            gitRef = "refs/tags/${tag}"
          }
          env.TAG_NAME = tag
          env.GIT_REF = gitRef
          if (params.PORTAL_PRODUCT_SIGLA) {
            env.PRODUTO_SIGLA = params.PORTAL_PRODUCT_SIGLA
          }
          if (params.RELEASE_VERSION) {
            env.VERSAO = params.RELEASE_VERSION
          }
          echo "Build origem=${params.ORIGEM ?: 'TAG'} tag=${env.TAG_NAME} ref=${env.GIT_REF}"
        }
        checkout([
          $class: 'GitSCM',
          branches: [[name: "${env.GIT_REF}"]],
          userRemoteConfigs: scm.userRemoteConfigs,
        ])
      }
    }

    stage('Build') {
      steps {
        sh "${env.BUILD_CMD}"
      }
    }

    stage('Locate artifact') {
      steps {
        script {
          def found = sh(
            script: "ls -1 ${env.BUILD_OUTPUT_DIR}/*.${env.ARTIFACT_EXT} | head -n 1",
            returnStdout: true,
          ).trim()
          if (!found) {
            error "Nenhum artefato .${env.ARTIFACT_EXT} encontrado em ${env.BUILD_OUTPUT_DIR}/"
          }
          env.ARTIFACT_PATH = found
          // Versão sem prefixo 'v' (1.5.0 em vez de v1.5.0)
          if (!env.VERSAO) {
            env.VERSAO = env.TAG_NAME.replaceFirst(/^v/, '')
          }
          env.ASSET_NAME = "${env.PRODUTO_SIGLA}-${env.MODULO_CODIGO}-${env.VERSAO}.${env.ARTIFACT_EXT}"
          echo "Artefato: ${env.ARTIFACT_PATH} → ${env.ASSET_NAME}"
        }
      }
    }

    stage('Publish to GitHub Release') {
      when { expression { return env.GH_TOKEN } }
      steps {
        sh '''
          set -eu
          # gh CLI deve estar disponível no agente; tente instalar/baixar se faltar
          if ! command -v gh >/dev/null 2>&1; then
            echo "gh CLI não encontrado; usando API REST" >&2
            REPO_FULL=$(git config --get remote.origin.url | sed -E 's#.*github.com[:/](.*)\\.git#\\1#')
            RELEASE_ID=$(curl -fsS \
              -H "Authorization: token ${GH_TOKEN}" \
              "https://api.github.com/repos/${REPO_FULL}/releases/tags/${TAG_NAME}" \
              | sed -n 's/.*"id": *\\([0-9]*\\).*/\\1/p' | head -n1)
            if [ -z "${RELEASE_ID}" ]; then
              RELEASE_ID=$(curl -fsS \
                -H "Authorization: token ${GH_TOKEN}" \
                -d "{\\"tag_name\\":\\"${TAG_NAME}\\",\\"name\\":\\"${TAG_NAME}\\"}" \
                "https://api.github.com/repos/${REPO_FULL}/releases" \
                | sed -n 's/.*"id": *\\([0-9]*\\).*/\\1/p' | head -n1)
            fi
            curl -fsS \
              -H "Authorization: token ${GH_TOKEN}" \
              -H "Content-Type: application/octet-stream" \
              --data-binary "@${ARTIFACT_PATH}" \
              "https://uploads.github.com/repos/${REPO_FULL}/releases/${RELEASE_ID}/assets?name=${ASSET_NAME}"
          else
            gh release view "${TAG_NAME}" >/dev/null 2>&1 \
              || gh release create "${TAG_NAME}" --title "${TAG_NAME}" --notes "Build automático"
            gh release upload "${TAG_NAME}" "${ARTIFACT_PATH}#${ASSET_NAME}" --clobber
          fi
        '''
      }
    }
  }

  post {
    success {
      echo "✅ Release ${env.TAG_NAME} publicada com asset ${env.ASSET_NAME}"
      notificarPortal('SUCCESS')
    }
    failure {
      echo "❌ Build falhou na tag ${env.TAG_NAME}"
      notificarPortal('FAILED')
    }
    aborted {
      notificarPortal('ABORTED')
    }
    unstable {
      notificarPortal('UNSTABLE')
    }
    always {
      archiveArtifacts artifacts: "${env.BUILD_OUTPUT_DIR}/*.${env.ARTIFACT_EXT}", allowEmptyArchive: true
    }
  }
}

// =============================================================================
// Função auxiliar: notifica o portal Nexus sobre o status do build (S11 P2).
// Falha silenciosa — se o portal estiver fora, não invalida o build.
// =============================================================================
def notificarPortal(String status) {
  if (!env.PORTAL_WEBHOOK_URL || !env.PORTAL_SECRET || !env.TAG_NAME) {
    echo "Portal webhook não configurado (PORTAL_WEBHOOK_URL/PORTAL_SECRET ausentes) — skip."
    return
  }
  def versao = env.TAG_NAME.replaceFirst(/^v/, '')
  def payload = """{
    "produtoSigla": "${env.PRODUTO_SIGLA}",
    "versao": "${versao}",
    "status": "${status}",
    "numero": ${env.BUILD_NUMBER ?: 'null'},
    "url": "${env.BUILD_URL ?: ''}"
  }"""
  try {
    sh """
      curl -fsS -X POST '${env.PORTAL_WEBHOOK_URL}' \
        -H 'Content-Type: application/json' \
        -H 'X-Webhook-Secret: ${env.PORTAL_SECRET}' \
        --data '${payload}' \
        --max-time 10 || echo 'Portal webhook falhou (não bloqueia build).'
    """
  } catch (e) {
    echo "Erro inesperado no webhook do portal: ${e.message}"
  }
}
